NODE_ENV=production
# connection_limit applies to each Node process. Keep it low on shared hosting.
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/meridian?connection_limit=5"
APP_URL="https://example.com"
AUTH_SECRET=""
TRUST_PROXY="1"
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
# Set to 1 only on a local development database. Never on production.
SEED_DEMO=
# Set to 1 when running `next build` on cPanel.
NEXT_BUILD_CPUS=
SMS_PROVIDER_URL=""
BACKUP_DIR=""
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMS_PROVIDER=
SMS_API_KEY=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

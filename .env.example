NODE_ENV=production
# connection_limit applies to each Node process. Keep it low on shared hosting.
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/meridian?connection_limit=5"
APP_URL="https://example.com"
AUTH_SECRET=""
TRUST_PROXY="1"
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
# Set to 1 only on a local development database. Never on production.
SEED_DEMO=
# Set to 1 when running `next build` on cPanel.
NEXT_BUILD_CPUS=
BACKUP_DIR=""
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMS (P10): empty = nothing is sent, messages wait in the outbox; dry-run = recorded as sent, not sent; http = the shop's provider.
SMS_PROVIDER=
# For SMS_PROVIDER=http: the provider's send URL with {to} {message} {sender} {api_key}; GET, or POST with SMS_HTTP_BODY as the form body.
SMS_HTTP_URL=
SMS_HTTP_METHOD=
SMS_HTTP_BODY=
# Optional: text the provider's answer contains when a message was accepted.
SMS_HTTP_SUCCESS=
SMS_API_KEY=
SMS_SENDER_ID=
# 880 (8801XXXXXXXXX, default) or 0 (01XXXXXXXXX), as the provider wants the number.
SMS_NUMBER_FORMAT=
# Optional: the provider's balance URL with {api_key}.
SMS_BALANCE_URL=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

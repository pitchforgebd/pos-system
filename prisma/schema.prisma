// Phase 03 schema.
// journals is the header. journal_lines are the lines. journal_entries is not a table.
// Quotations, requisitions, currency, discount type, warranty text, and generic are omitted.
// Stock transfer statuses are stored. No in-transit location is modeled.
// unitCost on a ledger row is nullable. No costing method is chosen.
// Document sequences are per organization, type, and year.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum DocumentStatus {
  DRAFT
  POSTED
  CANCELLED
}

/// A purchase: written down (DRAFT), sent to the vendor (ORDERED, nothing posted yet), received (RECEIVED: stock and books), or cancelled
/// before it was received.
enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum JournalStatus {
  DRAFT
  POSTED
}

/// What a ledger account is used for. Money accounts (cash, bank, mobile) are told apart by kind, not by code.
enum AccountKind {
  CASH
  BANK
  MOBILE
  OTHER
}

/// A journal is the posting of a document, or the reversal of that posting (one of each per document).
enum JournalKind {
  POSTING
  REVERSAL
}

/// Who a party line (receivable, payable, advance) is about.
enum PartyType {
  CUSTOMER
  VENDOR
  COURIER
  EMPLOYEE
}

enum Direction {
  IN
  OUT
}

/// One general header for the stock documents that have no document of their own (a transfer keeps stock_transfers).
enum StockDocumentType {
  OPENING
  OWN
  ADJUST
  DAMAGE
  EXPIRY
  TAKE_OFF
  TRANSFER
}

/// Why stock left the warehouse without a sale (D1). OWN_USE is the owner's drawing; the rest are an expense.
enum TakeOffPurpose {
  SAMPLE
  DEMO
  FIELD_TRIAL
  OWN_USE
  GIFT
}

enum SerialStatus {
  IN_STOCK
  RESERVED
  SOLD
  RETURNED
  DAMAGED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum StockMovementType {
  TAKE_OFF
  OPENING
  PURCHASE
  SALE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  EXPIRY
  ADJUSTMENT
  OWN_STOCK
}

enum TransferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  TRANSFERRED
  RECEIVED
}

enum ShiftStatus {
  OPEN
  ACTIVE
  CLOSING
  CLOSED
}

enum LoyaltyEntryType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
  REVERSAL
}

enum VoucherType {
  PAYMENT
  RECEIPT
  JOURNAL
  CONTRA
}

enum CapitalType {
  ADDED
  WITHDRAW
}

enum CustomerLedgerType {
  OPENING
  SALE
  PAYMENT
  RETURN
  ADJUSTMENT
  ADVANCE
}

enum SupplierLedgerType {
  OPENING
  PURCHASE
  PAYMENT
  RETURN
  ADJUSTMENT
}

enum AccountingTransactionType {
  SUPPLIER_DUE_PAYMENT
  CONTRA_BALANCE_TRANSFER
  DEALER_COLLECTION
  SUPPLIER_INSTANT_PAYMENT
  SUPPLIER_RETURN_REFUND
  LOAN_PAID
  LOAN_RECEIVED
  CAPITAL_ADDED
  CAPITAL_WITHDRAW
  EXPENSE_PAYMENT
  CUSTOMER_PRODUCT_RETURN
  SELL
  INDIRECT_INCOME
  OTHER_INCOME
  LIABILITY_RECEIVED
  LIABILITY_PAYMENT
  FIXED_ASSET_PURCHASE
  CUSTOMER_DUE_RECEIVED
}

enum DocumentType {
  STK
  INV
  PUR
  RET
  QUO
  REQ
  TRF
  PAY
  EXP
  VCH
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
}

enum RequisitionStatus {
  REQUESTED
  APPROVED
  REJECTED
  FULFILLED
}

enum SmsTemplateKind {
  BILL
  DUE_COLLECTION
}

enum InstallmentStatus {
  OPEN
  PAID
}

enum HeldTicketStatus {
  HELD
}

enum ImportBatchStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ImportRowStatus {
  PENDING
  IMPORTED
  SKIPPED
  FAILED
}

model Organization {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @db.VarChar(191)
  slug      String   @unique @db.VarChar(64)
  phone     String?  @db.VarChar(32)
  address   String?  @db.VarChar(255)
  bin       String?  @db.VarChar(32)
  tin       String?  @db.VarChar(32)
  logoUrl   String?  @db.VarChar(255)
  pointsPerHundred Decimal? @db.Decimal(18, 4)
  takaPerPoint     Decimal? @db.Decimal(18, 4)
  /// IANA time zone of the business day (N17). Documents and reports use this zone, never the server one.
  timezone             String    @default("Asia/Dhaka") @db.VarChar(64)
  /// First month of the fiscal year (D9: July).
  fiscalYearStartMonth Int       @default(7)
  /// No posting on or before this date (N9, invariant I11). Null means nothing is locked.
  lockedThrough        DateTime? @db.Date
  /// A posting dated further back than this many days needs the posting.backdate permission (D18).
  backdateDays         Int       @default(3)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches             Branch[]
  warehouses           Warehouse[]
  racks                Rack[]
  users                User[]
  roles                Role[]
  rolePermissions      RolePermission[]
  userRoles            UserRole[]
  userBranchAccess     UserBranchAccess[]
  sessions             Session[]
  passwordResets       PasswordReset[]
  brands               Brand[]
  categories           Category[]
  units                Unit[]
  products             Product[]
  productVariants      ProductVariant[]
  productImages        ProductImage[]
  productBarcodes      ProductBarcode[]
  productPrices        ProductPrice[]
  variationHeads       VariationHead[]
  variationValues      VariationValue[]
  productVariantValues ProductVariantValue[]
  stockBalances        StockBalance[]
  stockLedgers         StockLedger[]
  stockTransfers       StockTransfer[]
  stockTransferItems   StockTransferItem[]
  stockAdjustments     StockAdjustment[]
  damageRecords        DamageRecord[]
  expiryBatches        ExpiryBatch[]
  priceLevels          PriceLevel[]
  stockDocuments       StockDocument[]
  stockReservations    StockReservation[]
  supplierAdvances     SupplierAdvance[]
  openingStocks        OpeningStock[]
  ownStockInvoices     OwnStockInvoice[]
  customers            Customer[]
  customerTypes        CustomerType[]
  customerAddresses    CustomerAddress[]
  customerLedgers      CustomerLedger[]
  customerPayments     CustomerPayment[]
  customerAdvances     CustomerAdvance[]
  installments         Installment[]
  suppliers            Supplier[]
  supplierLedgers      SupplierLedger[]
  supplierPayments     SupplierPayment[]
  sales                Sale[]
  saleItems            SaleItem[]
  salePayments         SalePayment[]
  saleReturns          SaleReturn[]
  saleReturnItems      SaleReturnItem[]
  invoices             Invoice[]
  heldTickets          HeldTicket[]
  heldTicketItems      HeldTicketItem[]
  purchases            Purchase[]
  purchaseItems        PurchaseItem[]
  purchasePayments     PurchasePayment[]
  purchaseReturns      PurchaseReturn[]
  purchaseReturnItems  PurchaseReturnItem[]
  loyaltyTiers         LoyaltyTier[]
  loyaltyCards         LoyaltyCard[]
  loyaltyTransactions  LoyaltyTransaction[]
  accountGroups        AccountGroup[]
  accounts             Account[]
  journals             Journal[]
  journalLines         JournalLine[]
  accountRoles         AccountRole[]
  paymentAllocations   PaymentAllocation[]
  vouchers             Voucher[]
  expenses             Expense[]
  incomes              Income[]
  assets               Asset[]
  liabilities          Liability[]
  loans                Loan[]
  capitalTransactions  CapitalTransaction[]
  cashAccounts         CashAccount[]
  bankAccounts         BankAccount[]
  bankTransactions     BankTransaction[]
  shifts               Shift[]
  cashMovements        CashMovement[]
  cashHandovers        CashHandover[]
  smsTemplates         SmsTemplate[]
  smsMessages          SmsMessage[]
  smsLogs              SmsLog[]
  smsRechargeRequests  SmsRechargeRequest[]
  crmSegments          CrmSegment[]
  crmContacts          CrmContact[]
  crmActivities        CrmActivity[]
  crmAssignments       CrmAssignment[]
  settings             Setting[]
  fileAssets           FileAsset[]
  imports              Import[]
  importRows           ImportRow[]
  auditLogs            AuditLog[]
  apiLogs              ApiLog[]
  notificationLogs     NotificationLog[]
  quotations           Quotation[]
  requisitions         Requisition[]
  quotationItems       QuotationItem[]
  productSerials       ProductSerial[]
  warrantyClaims       WarrantyClaim[]
  couriers             Courier[]
  shipments            Shipment[]
  directReturns        DirectReturn[]
  documentSequences    DocumentSequence[]
  idempotencyKeys      IdempotencyKey[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  name           String       @db.VarChar(191)
  phone          String?      @db.VarChar(32)
  address        String?      @db.VarChar(255)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouses         Warehouse[]
  racks              Rack[]
  userAccess         UserBranchAccess[]
  sessions           Session[]
  stockBalances      StockBalance[]
  stockLedgers       StockLedger[]
  transfersFrom      StockTransfer[]    @relation("TransferFromBranch")
  transfersTo        StockTransfer[]    @relation("TransferToBranch")
  stockAdjustments   StockAdjustment[]
  damageRecords      DamageRecord[]
  expiryBatches      ExpiryBatch[]
  stockDocuments     StockDocument[]
  supplierAdvances   SupplierAdvance[]
  openingStocks      OpeningStock[]
  ownStockInvoices   OwnStockInvoice[]
  sales              Sale[]
  saleReturns        SaleReturn[]
  purchases          Purchase[]
  purchaseReturns    PurchaseReturn[]
  invoices           Invoice[]
  heldTickets        HeldTicket[]
  customerLedgers    CustomerLedger[]
  customerPayments   CustomerPayment[]
  customerAdvances   CustomerAdvance[]
  supplierLedgers    SupplierLedger[]
  supplierPayments   SupplierPayment[]
  journals           Journal[]
  journalLines       JournalLine[]
  vouchers           Voucher[]
  expenses           Expense[]
  incomes            Income[]
  capitalTransactions CapitalTransaction[]
  cashAccounts       CashAccount[]
  bankAccounts       BankAccount[]
  bankTransactions   BankTransaction[]
  shifts             Shift[]
  auditLogs          AuditLog[]
  quotations         Quotation[]
  requisitions       Requisition[]
  warrantyClaims     WarrantyClaim[]
  shipments          Shipment[]
  directReturns      DirectReturn[]

  @@index([organizationId])
  @@map("branches")
}

model Warehouse {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  branchId       String       @db.Char(36)
  name           String       @db.VarChar(191)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  racks            Rack[]
  stockBalances    StockBalance[]
  stockLedgers     StockLedger[]
  expiryBatches    ExpiryBatch[]
  stockDocuments   StockDocument[]
  stockReservations StockReservation[]
  serials          ProductSerial[]
  transfersFrom    StockTransfer[]   @relation("TransferFromWarehouse")
  transfersTo      StockTransfer[]   @relation("TransferToWarehouse")
  stockAdjustments StockAdjustment[]
  openingStocks    OpeningStock[]
  ownStockInvoices OwnStockInvoice[]
  sales            Sale[]
  purchases        Purchase[]
  directReturns    DirectReturn[]

  @@index([organizationId, branchId])
  @@map("warehouses")
}

model Rack {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  branchId       String       @db.Char(36)
  warehouseId    String       @db.Char(36)
  name           String       @db.VarChar(191)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([organizationId, warehouseId])
  @@map("racks")
}

model User {
  id             String     @id @default(uuid()) @db.Char(36)
  organizationId String     @db.Char(36)
  name           String     @db.VarChar(191)
  email          String     @db.VarChar(191)
  passwordHash   String     @db.VarChar(255)
  phone          String?    @db.VarChar(32)
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles             UserRole[]
  branchAccess      UserBranchAccess[]
  sessions          Session[]
  passwordResets    PasswordReset[]
  stockLedgers      StockLedger[]
  damageRecords     DamageRecord[]
  shifts            Shift[]
  cashMovements     CashMovement[]
  handoversFrom     CashHandover[]     @relation("HandoverFrom")
  handoversTo       CashHandover[]     @relation("HandoverTo")
  heldTickets       HeldTicket[]
  auditLogs         AuditLog[]
  apiLogs           ApiLog[]
  idempotencyKeys   IdempotencyKey[]
  crmAssignments    CrmAssignment[]
  createdProducts   Product[]          @relation("ProductCreatedBy")
  updatedProducts   Product[]          @relation("ProductUpdatedBy")
  createdCustomers  Customer[]         @relation("CustomerCreatedBy")
  updatedCustomers  Customer[]         @relation("CustomerUpdatedBy")
  createdSuppliers  Supplier[]         @relation("SupplierCreatedBy")
  updatedSuppliers  Supplier[]         @relation("SupplierUpdatedBy")
  createdSales      Sale[]             @relation("SaleCreatedBy")
  createdPurchases  Purchase[]         @relation("PurchaseCreatedBy")
  createdJournals   Journal[]          @relation("JournalCreatedBy")
  createdTransfers  StockTransfer[]    @relation("TransferCreatedBy")
  createdQuotations Quotation[]        @relation("QuotationCreatedBy")
  requestedRequisitions Requisition[]  @relation("RequisitionRequestedBy")
  decidedRequisitions Requisition[]    @relation("RequisitionDecidedBy")
  fileAssets        FileAsset[]
  imports           Import[]

  @@unique([organizationId, email])
  @@index([email])
  @@index([organizationId, status])
  @@map("users")
}

model Role {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @db.Char(36)
  name           String   @db.VarChar(191)
  note           String?  @db.VarChar(255)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(64)
  module      String   @db.VarChar(64)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id             String @id @default(uuid()) @db.Char(36)
  organizationId String @db.Char(36)
  roleId         String @db.Char(36)
  permissionId   String @db.Char(36)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([organizationId])
  @@map("role_permissions")
}

model UserRole {
  id             String @id @default(uuid()) @db.Char(36)
  organizationId String @db.Char(36)
  userId         String @db.Char(36)
  roleId         String @db.Char(36)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([organizationId])
  @@map("user_roles")
}

model UserBranchAccess {
  id             String @id @default(uuid()) @db.Char(36)
  organizationId String @db.Char(36)
  userId         String @db.Char(36)
  branchId       String @db.Char(36)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([userId, branchId])
  @@index([organizationId])
  @@map("user_branch_access")
}

model Session {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @db.Char(36)
  userId         String    @db.Char(36)
  tokenHash      String    @unique @db.VarChar(64)
  expiresAt      DateTime
  revokedAt      DateTime?
  branchId       String?   @db.Char(36)
  ip             String?   @db.VarChar(45)
  userAgent      String?   @db.VarChar(255)
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([organizationId, userId])
  @@map("sessions")
}

model PasswordReset {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @db.Char(36)
  userId         String    @db.Char(36)
  tokenHash      String    @unique @db.VarChar(64)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, userId])
  @@map("password_resets")
}

model Brand {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  name           String       @db.VarChar(191)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  @@index([organizationId, name])
  @@map("brands")
}

model Category {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  name           String       @db.VarChar(191)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  @@index([organizationId, name])
  @@map("categories")
}

model Unit {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  name           String       @db.VarChar(191)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  @@index([organizationId, name])
  @@map("units")
}

model Product {
  id                String       @id @default(uuid()) @db.Char(36)
  organizationId    String       @db.Char(36)
  sku               String       @db.VarChar(64)
  /// Equals sku while the product is not deleted. Null after soft delete so MySQL uniqueness applies only to live rows.
  liveSku           String?      @db.VarChar(64)
  name              String       @db.VarChar(191)
  slug              String       @db.VarChar(191)
  description       String?      @db.Text
  brandId           String?      @db.Char(36)
  categoryId        String?      @db.Char(36)
  unitId            String?      @db.Char(36)
  purchasePrice     Decimal      @db.Decimal(18, 2)
  sellingPrice      Decimal      @db.Decimal(18, 2)
  wholesalePrice    Decimal      @db.Decimal(18, 2)
  minimumPrice      Decimal      @db.Decimal(18, 2)
  /// Stored value only. Inclusive versus exclusive math is not defined.
  vatType           String?      @db.VarChar(32)
  vatValue          Decimal?     @db.Decimal(18, 4)
  trackStock        Boolean
  trackExpiry       Boolean
  trackBatch        Boolean
  trackSerial       Boolean
  reorderLevel      Decimal      @default(0) @db.Decimal(18, 4)
  warrantyAvailable Boolean      @default(false)
  /// A service or other non-stock item: sold with no stock movement (service charge, transport).
  isService         Boolean      @default(false)
  /// The generic (active ingredient) name, searched with the name and SKU.
  genericName       String?      @db.VarChar(191)
  status            RecordStatus @default(ACTIVE)
  createdById       String?      @db.Char(36)
  updatedById       String?      @db.Char(36)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand        Brand?        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit         Unit?         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdBy    User?         @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?         @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  variants     ProductVariant[]
  images       ProductImage[]
  barcodes     ProductBarcode[]
  prices       ProductPrice[]
  balances     StockBalance[]
  ledgers         StockLedger[]
  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[]
  heldTicketItems HeldTicketItem[]
  transferItems   StockTransferItem[]
  adjustments     StockAdjustment[]
  damageRecords   DamageRecord[]
  expiryBatches   ExpiryBatch[]
  serials         ProductSerial[]
  stockReservations StockReservation[]
  quotationItems  QuotationItem[]
  warrantyClaims  WarrantyClaim[]
  directReturns   DirectReturn[]

  @@unique([organizationId, liveSku])
  @@unique([organizationId, slug])
  @@index([organizationId, categoryId])
  @@index([organizationId, brandId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, deletedAt, name])
  @@map("products")
}

model VariationHead {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @db.Char(36)
  name           String   @db.VarChar(191)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  values       VariationValue[]
  assignments  ProductVariantValue[]

  @@unique([organizationId, name])
  @@map("variation_heads")
}

model VariationValue {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @db.Char(36)
  headId         String   @db.Char(36)
  value          String   @db.VarChar(191)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  head         VariationHead         @relation(fields: [headId], references: [id], onDelete: Cascade)
  assignments  ProductVariantValue[]

  @@unique([headId, value])
  @@index([organizationId])
  @@map("variation_values")
}

model ProductVariant {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @db.Char(36)
  productId      String    @db.Char(36)
  sku            String    @db.VarChar(64)
  price          Decimal?  @db.Decimal(18, 2)
  weight         Decimal?  @db.Decimal(18, 4)
  manufacturedOn DateTime? @db.Date
  expiresOn      DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  values       ProductVariantValue[]
  images       ProductImage[]
  barcodes     ProductBarcode[]
  prices       ProductPrice[]
  balances     StockBalance[]
  ledgers         StockLedger[]
  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[]

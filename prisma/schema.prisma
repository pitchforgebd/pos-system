/// What a product (or one variant of it) sells for at a price level, from a minimum quantity: Wholesale 10+ bags 950, 50+ bags 920.
model ProductPrice {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @db.Char(36)
  productId      String   @db.Char(36)
  variantId      String?  @db.Char(36)
  /// The variant's id, or an empty string for the product itself (MySQL unique indexes do not treat NULL as one value).
  variantScope   String   @default("") @db.VarChar(36)
  priceLevelId   String   @db.Char(36)
  /// The price applies from this quantity up (the largest step not above the quantity wins).
  minQty         Decimal  @default(1) @db.Decimal(18, 4)
  price          Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  priceLevel   PriceLevel      @relation(fields: [priceLevelId], references: [id], onDelete: Restrict)

  @@unique([organizationId, productId, variantScope, priceLevelId, minQty])
  @@index([organizationId, productId])
  @@index([priceLevelId])
  @@map("product_prices")
}

/// A price list: Retail (the default), Wholesale, Dealer, and any the owner adds (D6).
model PriceLevel {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  name           String       @db.VarChar(64)
  /// The level used when nothing else is chosen, and the one a price falls back to. Exactly one per organization.
  isDefault      Boolean      @default(false)
  sortOrder      Int          @default(0)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  prices        ProductPrice[]
  customerTypes CustomerType[]

  @@unique([organizationId, name])
  @@map("price_levels")
}

model StockBalance {
  id             String  @id @default(uuid()) @db.Char(36)
  organizationId String  @db.Char(36)
  productId      String  @db.Char(36)
  variantId      String? @db.Char(36)
  /// Empty string when there is no variant. MySQL unique indexes do not treat NULL as one value.
  variantScope   String  @default("") @db.VarChar(36)
  branchId       String  @db.Char(36)
  warehouseId    String  @db.Char(36)
  quantity       Decimal @db.Decimal(18, 4)
  /// Held for confirmed orders (P06); never more than the quantity.
  reservedQty    Decimal @default(0) @db.Decimal(18, 4)
  /// Moving-average unit cost of the stock on hand. Null until a stock-in with a cost arrives.
  averageCost    Decimal? @db.Decimal(18, 4)
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([organizationId, productId, variantScope, branchId, warehouseId])
  @@index([organizationId, branchId])
  @@map("stock_balances")
}

model StockLedger {
  id             String            @id @default(uuid()) @db.Char(36)
  organizationId String            @db.Char(36)
  productId      String            @db.Char(36)
  variantId      String?           @db.Char(36)
  branchId       String            @db.Char(36)
  warehouseId    String?           @db.Char(36)
  quantity       Decimal           @db.Decimal(18, 4)
  direction      Direction
  movementType   StockMovementType
  referenceType  String            @db.VarChar(64)
  referenceId    String            @db.Char(36)
  /// Present when the operation has a cost: four decimals (N13).
  unitCost       Decimal?          @db.Decimal(18, 4)
  /// quantity x unitCost in money (two decimals): what the movement is worth in the books.
  totalCost      Decimal?          @db.Decimal(18, 2)
  /// The day the movement belongs to (Dhaka), not the day it was typed.
  businessDate   DateTime          @default(dbgenerated("(curdate())")) @db.Date
  userId         String            @db.Char(36)
  createdAt      DateTime          @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse    Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  user         User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, businessDate])
  @@index([organizationId, productId, branchId, createdAt])
  @@index([organizationId, branchId, createdAt])
  @@index([organizationId, referenceType, referenceId])
  @@map("stock_ledgers")
}

/// The header of a stock document that has no table of its own: opening, own stock, adjustment, damage, expiry write-off, take-off.
/// The movements are the stock ledger rows that point at it (referenceType "stock_document"); the books are its journal.
model StockDocument {
  id               String            @id @default(uuid()) @db.Char(36)
  organizationId   String            @db.Char(36)
  branchId         String            @db.Char(36)
  warehouseId      String            @db.Char(36)
  type             StockDocumentType
  number           String?           @db.VarChar(32)
  businessDate     DateTime          @db.Date
  reason           String?           @db.VarChar(255)
  /// Damage: where it happened.
  place            String?           @db.VarChar(191)
  takeOffPurpose   TakeOffPurpose?
  /// Take-off: who received the goods, who approved, and a note.
  recipient        String?           @db.VarChar(191)
  approvedBy       String?           @db.VarChar(191)
  note             String?           @db.VarChar(500)
  /// Take-off: the expense account chosen instead of the purpose's default.
  expenseAccountId String?           @db.Char(36)
  journalId        String?           @unique @db.Char(36)
  createdById      String?           @db.Char(36)
  createdAt        DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  journal      Journal?     @relation(fields: [journalId], references: [id], onDelete: Restrict)

  @@unique([organizationId, number])
  @@index([organizationId, branchId, type, businessDate])
  @@map("stock_documents")
}

/// Stock held for a confirmed order (P06): active until the order is dispatched (consumed) or cancelled (released).

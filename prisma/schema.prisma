model Journal {
  id             String        @id @default(uuid()) @db.Char(36)
  organizationId String        @db.Char(36)
  branchId       String?       @db.Char(36)
  number         String?       @db.VarChar(32)
  businessDate     DateTime      @db.Date
  status         JournalStatus @default(DRAFT)
  description    String?       @db.VarChar(255)
  postedAt       DateTime?
  reversalOfId   String?       @db.Char(36)
  /// The document this journal posts ("SALE", "PURCHASE", ...) and its id; empty for a manual journal until P02 task 4.
  docType        String?       @db.VarChar(32)
  docId          String?       @db.Char(36)
  kind           JournalKind   @default(POSTING)
  createdById    String?       @db.Char(36)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch?            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  paymentAllocations PaymentAllocation[]
  stockDocument  StockDocument?
  supplierAdvance SupplierAdvance? @relation("SupplierAdvanceJournal")
  reversalOf     Journal?           @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals      Journal[]          @relation("JournalReversal")
  createdBy      User?              @relation("JournalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines          JournalLine[]
  sale           Sale?              @relation("SaleJournal")
  saleReturn     SaleReturn?        @relation("SaleReturnJournal")
  purchase       Purchase?          @relation("PurchaseJournal")
  purchaseReturn PurchaseReturn?    @relation("PurchaseReturnJournal")
  customerPayment CustomerPayment?
  customerAdvance CustomerAdvance?  @relation("AdvanceJournal")
  supplierPayment SupplierPayment?  @relation("SupplierPaymentJournal")
  voucher        Voucher?
  expense        Expense?
  income         Income?
  capitalTransaction CapitalTransaction?
  bankTransaction BankTransaction?
  directReturn    DirectReturn?

  @@unique([organizationId, number])
  @@unique([docType, docId, kind])
  @@index([organizationId, status, businessDate])
  @@index([organizationId, branchId, status, businessDate])
  @@map("journals")
}

model JournalLine {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @db.Char(36)
  journalId      String   @db.Char(36)
  accountId      String   @db.Char(36)
  debit          Decimal  @default(0) @db.Decimal(18, 2)
  credit         Decimal  @default(0) @db.Decimal(18, 2)
  memo           String?  @db.VarChar(255)
  /// Who the line is about. Receivable, payable, advance and courier lines carry a party; no other line does (I2).
  partyType      PartyType?
  partyId        String?  @db.Char(36)
  shiftId        String?  @db.Char(36)
  branchId       String?  @db.Char(36)
  /// Copied from the journal so reports can filter and group lines without a join.
  businessDate   DateTime @db.Date
  /// Set by the fixed-assets phase (P09); no foreign key until that table exists.
  assetId        String?  @db.Char(36)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  journal      Journal      @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  shift        Shift?       @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([journalId])
  @@index([accountId, createdAt])
  @@index([organizationId, accountId, businessDate])
  @@index([organizationId, partyType, partyId, businessDate])
  @@index([shiftId])
  @@map("journal_lines")
}


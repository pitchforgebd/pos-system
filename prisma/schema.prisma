/// Which ledger account plays which part ("CASH", "AR", "SALES" ...). Code never names an account by its number:
/// it asks for the role (accountFor). Cash, bank and mobile accounts are chosen by the user, so they have no role of
/// their own except the default ones ("BANK:DEFAULT", "MOBILE:DEFAULT").
model AccountRole {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @db.Char(36)
  role           String   @db.VarChar(48)
  accountId      String   @db.Char(36)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([organizationId, role])
  @@index([accountId])
  @@map("account_roles")
}

/// Which part of a receipt or payment settles which invoice (customer receipts) or bill (vendor payments).
/// The journal is the receipt/payment; exactly one of invoiceId and billId is set.
model PaymentAllocation {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @db.Char(36)
  journalId      String   @db.Char(36)
  invoiceId      String?  @db.Char(36)
  billId         String?  @db.Char(36)
  amount         Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  journal      Journal      @relation(fields: [journalId], references: [id], onDelete: Restrict)
  // onUpdate Restrict: MySQL does not allow a column with ON UPDATE CASCADE in a CHECK, and ids never change.
  invoice      Sale?        @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bill         Purchase?    @relation(fields: [billId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, invoiceId])
  @@index([organizationId, billId])
  @@index([journalId])
  @@map("payment_allocations")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @db.Char(36)
  userId         String   @db.Char(36)
  key            String   @db.VarChar(64)
  requestHash    String   @db.VarChar(64)
  entityType     String   @db.VarChar(64)
  entityId       String   @db.Char(36)
  /// The answer the first request got. A repeated request is answered with exactly this (N24).
  response       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model QuotationItem {
  id             String  @id @default(uuid()) @db.Char(36)
  organizationId String  @db.Char(36)
  quotationId    String  @db.Char(36)
  productId      String  @db.Char(36)
  quantity       Decimal @db.Decimal(18, 4)
  unitPrice      Decimal @db.Decimal(18, 2)
  lineTotal      Decimal @db.Decimal(18, 2)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quotation    Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([quotationId])
  @@map("quotation_items")
}

model ProductSerial {
  id             String  @id @default(uuid()) @db.Char(36)
  organizationId String  @db.Char(36)
  productId      String  @db.Char(36)
  variantId      String? @db.Char(36)
  /// Where the unit is (a sale only takes a serial that is in the warehouse it sells from).
  warehouseId    String? @db.Char(36)
  serial         String  @db.VarChar(64)
  status         SerialStatus @default(IN_STOCK)
  saleId         String? @db.Char(36)
  /// The stock ledger row that brought the unit in (a purchase or an opening): serials are added on stock-in only.
  inMovementId   String? @db.Char(36)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse    Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  sale         Sale?        @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, serial])
  @@index([productId, status])
  @@map("product_serials")
}

model WarrantyClaim {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @db.Char(36)
  branchId       String   @db.Char(36)
  productId      String   @db.Char(36)
  customerId     String   @db.Char(36)
  serial         String?  @db.VarChar(64)
  note           String   @db.VarChar(255)
  status         String   @default("OPEN") @db.VarChar(16)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@map("warranty_claims")
}

model Courier {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @db.Char(36)
  name           String   @db.VarChar(191)
  phone          String?  @db.VarChar(32)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shipments    Shipment[]

  @@index([organizationId, name])
  @@map("couriers")
}

model Shipment {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @db.Char(36)
  branchId       String   @db.Char(36)
  courierId      String   @db.Char(36)
  customerId     String?  @db.Char(36)
  reference      String?  @db.VarChar(64)
  trackingCode   String?  @db.VarChar(64)
  status         String   @default("PENDING") @db.VarChar(16)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  courier      Courier      @relation(fields: [courierId], references: [id], onDelete: Restrict)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([organizationId, branchId])
  @@map("shipments")
}

model DirectReturn {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @db.Char(36)
  branchId       String   @db.Char(36)
  warehouseId    String   @db.Char(36)
  productId      String   @db.Char(36)
  customerId     String?  @db.Char(36)
  quantity       Decimal  @db.Decimal(18, 4)
  refundAmount   Decimal  @db.Decimal(18, 2)
  method         String   @db.VarChar(16)
  journalId      String?  @unique @db.Char(36)
  businessDate     DateTime @db.Date
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  journal      Journal?     @relation(fields: [journalId], references: [id], onDelete: Restrict)

  @@index([organizationId, branchId, businessDate])
  @@map("direct_returns")
}
